# Aplicación y servidor
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace_with_a_long_random_secret

# Autenticación alternativa (reemplaza el OAuth de Manus antes de salir)
# Elegir un único proveedor o implementar sesión local.
AUTH_PROVIDER=replace_with_auth0_clerk_supabase_or_custom
AUTH_ISSUER_URL=https://your-auth-provider.example
AUTH_CLIENT_ID=replace_me
AUTH_CLIENT_SECRET=replace_me
AUTH_REDIRECT_URL=https://app.example.com/api/oauth/callback
ADMIN_IDENTIFIER=admin@example.com

# LLM alternativa (reemplaza BUILT_IN_FORGE_API_URL y BUILT_IN_FORGE_API_KEY)
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace_me
LLM_MODEL=gemini-2.5-flash

# Almacenamiento S3 compatible (reemplaza /manus-storage y Forge Storage)
S3_REGION=us-east-1
S3_BUCKET=tarot-audio-production
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
# S3_ENDPOINT=https://s3.your-provider.example # Sólo para proveedores S3 compatibles.
PUBLIC_ASSET_BASE_URL=https://cdn.example.com

# Notificación a la administradora (reemplaza Manus Notification Service)
# Usar una URL de webhook, correo transaccional o proveedor elegido.
OWNER_NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/notifications

# Analítica opcional (reemplaza la analítica administrada de Manus o se elimina el script)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=replace_me

# Pagos
# La aplicación actual usa el enlace PayPal.me guardado en la tabla settings.
# Dodo Payments no está integrado hoy: agregar sólo si se decide reemplazar ese flujo.
